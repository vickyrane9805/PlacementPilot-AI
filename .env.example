# Groq API configuration for PlacementPilot AI Mentor
# Create a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Optional: private Vercel Blob token for automatic placementpilot.db backups
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here